# Публичные настройки игры — не секреты, их видно в самой игре. Секреты (токен бота, пароль базы, токен Supabase)
# хранятся только в GitHub: Settings → Secrets and variables → Actions → Secrets.
# Адрес проекта Supabase, вида https://abcd1234.supabase.co
SUPABASE_URL=
# Ключ anon (или publishable, sb_publishable_…). Если пусто — workflow возьмёт его сам по SUPABASE_ACCESS_TOKEN
SUPABASE_ANON_KEY=
# Ник бота без @, например shpa_mei_bot
BOT_USERNAME=
# Канал ППО без @ — для проверки подписки
TG_CHANNEL=
# true — тест-режим (всё открыто, стычки каждые 10 минут). Перед выездом поставить false
TEST_MODE=true
YANDEX_MAPS_KEY=
